model InstagramAccount {
  id                      Int                   @id @default(autoincrement())
  integrationConnectionId Int                   @unique
  instagramUserId         String                @unique
  username                String
  name                    String?
  profilePictureUrl       String?
  lastSyncedAt            DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  media                   InstagramMedia[]

  @@index([username])
}

model InstagramMedia {
  id                 Int                              @id @default(autoincrement())
  instagramAccountId Int
  instagramMediaId   String                           @unique
  caption            String?
  mediaType          String
  mediaUrl           String?
  thumbnailUrl       String?
  permalink          String
  publishedAt        DateTime
  lastSyncedAt       DateTime                         @default(now())
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  instagramAccount   InstagramAccount                 @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automationRules    InstagramCommentAutomationRule[]
  commentEvents      InstagramCommentEvent[]

  @@index([instagramAccountId, publishedAt])
}

model InstagramCommentAutomationRule {
  id               Int                       @id @default(autoincrement())
  instagramMediaId Int
  name             String
  keywords         Json
  matchType        InstagramCommentMatchType @default(ANY_KEYWORD)
  publicReplyText  String?
  privateReplyText String
  status           InstagramAutomationStatus @default(DISABLED)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  instagramMedia   InstagramMedia            @relation(fields: [instagramMediaId], references: [id], onDelete: Cascade)
  commentEvents    InstagramCommentEvent[]

  @@index([instagramMediaId, status])
}

model InstagramCommentEvent {
  id                 Int                             @id @default(autoincrement())
  automationRuleId   Int?
  instagramMediaId   Int
  instagramCommentId String                          @unique
  commenterId        String?
  commenterUsername  String?
  commentText        String?
  status             InstagramCommentEventStatus     @default(RECEIVED)
  publicReplyId      String?
  privateMessageId   String?
  failureDetail      String?
  receivedAt         DateTime                        @default(now())
  processedAt        DateTime?
  automationRule     InstagramCommentAutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  instagramMedia     InstagramMedia                  @relation(fields: [instagramMediaId], references: [id], onDelete: Cascade)

  @@index([instagramMediaId, receivedAt])
  @@index([status, receivedAt])
}

enum InstagramCommentMatchType {
  ANY_KEYWORD
  ALL_KEYWORDS
  EXACT
}

enum InstagramAutomationStatus {
