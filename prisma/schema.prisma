generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id             Int           @id @default(autoincrement())
  externalId     String        @unique
  messageIndex   Int           @default(0)
  content        String
  createdAt      DateTime      @default(now())
  conversationId Int
  status         MessageStatus
  type           MessageType

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, messageIndex])
}

model Conversation {
  id                 Int                @id @default(autoincrement())
  conclusion         String?
  conversationStatus ConversationStatus
  businessId         Int
  clientId           Int
  channel            String             @default("whatsapp")
  provider           String             @default("twilio")
  createdAt          DateTime           @default(now())
  lastUserMessageAt  DateTime?
  lastBotMessageAt   DateTime?
  lastFollowUpAt     DateTime?
  followUpCount      Int                @default(0)
  nextFollowUpAt     DateTime?
  business           Business           @relation(fields: [businessId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id])
  messages           Message[]
  parameterAnswers   ParameterAnswer[]
  followUps          ConversationFollowUp[]
}

model Business {
  id                Int                 @id @default(autoincrement())
  businessName      String
  businessPhone     String
  businessEmail     String
  enderMessage      String
  escalationMessage String
  language          String
  starterMessage    String
  parameters        BusinessParameter[]
  users             BusinessUser[]
  conversations     Conversation[]
  followUpPolicy    BusinessFollowUpPolicy?
  conversationFollowUps ConversationFollowUp[]
  context           BusinessContext?
  BusinessAction    BusinessAction?
  leads             Lead[]
  channels          BusinessChannel[]
  integrationConnections IntegrationConnection[]
  incomingLeads     IncomingLead[]
  providerWebhookEvents ProviderWebhookEvent[]
  externalLeads     ExternalLead[]
  ingestionOutbox   IngestionOutbox[]
}

model BusinessContext {
  id                 Int      @id @default(autoincrement())
  businessId         Int      @unique
  profileName        String
  profileLanguage    String
  profileTone        String
  description        String?
  serviceCatalog     Json
  conversationPolicy Json
  knownClientContext Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id])
}

model AppUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  displayName  String?
  platformRole PlatformRole   @default(user)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  businesses   BusinessUser[]
  leads        Lead[]
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id           Int       @id @default(autoincrement())
  userId       Int
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedByHash String?
  createdAt    DateTime  @default(now())
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model BusinessUser {
  id         Int              @id @default(autoincrement())
  userId     Int
  businessId Int
  role       BusinessUserRole @default(owner)
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id])
  user       AppUser          @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
}

model Client {
  id            Int               @id @default(autoincrement())
  phoneNumber   String            @unique
  name          String?
  conversations Conversation[]
  answers       ParameterAnswer[]
  leads         Lead[]
}

model BusinessParameter {
  id         Int               @id @default(autoincrement())
  paramName  String
  businessId Int
  business   Business          @relation(fields: [businessId], references: [id])
  use        Boolean          @default(true)
  answers    ParameterAnswer[]

  @@unique([businessId, paramName])
}

model ParameterAnswer {
  id                Int               @id @default(autoincrement())
  paramAnswer       String
  createdAt         DateTime          @default(now())
  clientId          Int
  paramId           Int
  conversationId    Int
  client            Client            @relation(fields: [clientId], references: [id])
  conversation      Conversation      @relation(fields: [conversationId], references: [id])
  businessParameter BusinessParameter @relation(fields: [paramId], references: [id])

  @@index([conversationId, paramId])
}

model BusinessAction {
  id         Int        @id @default(autoincrement())
  provider   String?
  config     Json?
  action     ActionType
  businessId Int
  business   Business   @relation(fields: [businessId], references: [id])

  @@unique([businessId])
}

model BusinessChannel {
  id                    Int      @id @default(autoincrement())
  businessId            Int
  channel               String
  provider              String
  displayName           String?
  status                String   @default("pending")
  onboardingType        String   @default("manual")
  credentialsEncrypted  String?
  config                Json?
  externalAccountId     String?
  externalPhoneNumberId String?
  webhookUrl            String?
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, channel, provider])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessFollowUpPolicy {
  id               Int      @id @default(autoincrement())
  businessId       Int      @unique
  enabled          Boolean  @default(false)
  timezone         String   @default("UTC")
  delayMinutes     Int      @default(1440)
  allowedStartHour Int?
  allowedEndHour   Int?
  maxFollowUps     Int      @default(1)
  messageTemplate  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id])
}

model ConversationFollowUp {
  id             Int            @id @default(autoincrement())
  businessId     Int
  conversationId Int
  leadId         Int?
  status         FollowUpStatus @default(PENDING)
  scheduledFor   DateTime
  sentAt         DateTime?
  skippedReason  String?
  messageBody    String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id])
  conversation   Conversation   @relation(fields: [conversationId], references: [id])
  lead           Lead?          @relation(fields: [leadId], references: [id])

  @@index([businessId, status, scheduledFor])
  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model Lead {
  id Int @id @default(autoincrement())

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  memberId Int?
  member   AppUser? @relation(fields: [memberId], references: [id])

  status LeadStatus @default(NEW)

  source LeadSource @default(WHATSAPP)
  origin LeadOrigin @default(MANUAL)

  score   Int?
  summary String?
  notes   String?

  name    String?
  email   String?
  phoneNumber String?

  createdAt  DateTime  @default(now())
  asignTime  DateTime?
  updatedAt  DateTime  @updatedAt
  followUpAt DateTime?
  closedAt   DateTime?
  followUps  ConversationFollowUp[]
  externalLeads ExternalLead[]
  attributions LeadAttribution[]
}

model IntegrationConnection {
  id                    Int      @id @default(autoincrement())
  businessId            Int
  provider              String
  integrationType       IntegrationType
  status                IntegrationConnectionStatus @default(PENDING)
  connectionToken       String   @unique
  displayName           String?
  externalAccountId     String?
  externalResourceId    String?
  credentialsEncrypted  String?
  webhookSecretEncrypted String?
  config                Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Business @relation(fields: [businessId], references: [id])
  incomingLeads         IncomingLead[]
  externalLeads         ExternalLead[]
  providerWebhookEvents ProviderWebhookEvent[]

  @@unique([businessId, provider, integrationType, externalResourceId])
  @@index([businessId, status])
}

model IncomingLead {
  id                      Int      @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  provider                String
  eventType               String
  providerEventId         String?
  idempotencyKey          String
  payloadHash             String
  rawPayload              Json?
  canonicalPayload        Json
  status                  IncomingLeadStatus @default(RECEIVED)
  failureCode             String?
  failureDetail           String?
  receivedAt              DateTime @default(now())
  processedAt             DateTime?
  externalLeadId          Int?
  business                Business @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])
  externalLead            ExternalLead? @relation(fields: [externalLeadId], references: [id])

  @@unique([integrationConnectionId, idempotencyKey])
  @@index([businessId, status, receivedAt])
  @@index([externalLeadId])
}

model ExternalLead {
  id                      Int      @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  leadId                  Int
  provider                String
  externalLeadId          String
  externalContactId       String?
  metadata                Json?
  firstReceivedAt         DateTime @default(now())
  lastReceivedAt          DateTime @default(now())
  business                Business @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])
  lead                    Lead @relation(fields: [leadId], references: [id])
  incomingLeads           IncomingLead[]

  @@unique([integrationConnectionId, externalLeadId])
  @@index([businessId, leadId])
}

model LeadAttribution {
  id                Int      @id @default(autoincrement())
  leadId            Int
  provider          String?
  campaignExternalId String?
  campaignName      String?
  formExternalId    String?
  formName          String?
  adExternalId      String?
  adSetExternalId   String?
  landingPageUrl    String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  referrer          String?
  raw               Json?
  createdAt         DateTime @default(now())
  lead              Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
}

model IngestionOutbox {
  id            Int      @id @default(autoincrement())
  businessId    Int
  aggregateType String
  aggregateId   Int
  eventType     String
  payload       Json
  status        IngestionOutboxStatus @default(PENDING)
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id])

  @@unique([aggregateType, aggregateId, eventType])
  @@index([status, availableAt])
}

model ProviderWebhookEvent {
  id                      Int      @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  provider                String
  eventType               String
  providerEventId         String
  payloadHash             String
  payload                 Json
  status                  ProviderWebhookEventStatus @default(RECEIVED)
  failureCode             String?
  failureDetail           String?
  receivedAt              DateTime @default(now())
  processedAt             DateTime?
  business                Business @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])

  @@unique([integrationConnectionId, providerEventId])
  @@index([businessId, status, receivedAt])
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  ASSIGNED
  FOLLOW_UP
  WON
  LOST
  CLOSED
}

enum LeadSource {
  WHATSAPP
  MANUAL
  FACEBOOK
  GOOGLE_ADS
  WEBSITE
  OTHER
}

enum LeadOrigin {
  CAMPAIGN
  CONVERSATION
  MANUAL
  API
  IMPORT
}

enum IntegrationType {
  LEAD_ADS
  FORM
  LANDING_PAGE
  CUSTOM_API
  MESSAGING
}

enum IntegrationConnectionStatus {
  PENDING
  ACTIVE
  DISABLED
  FAILED
}

enum IncomingLeadStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum IngestionOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ProviderWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum FollowUpStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
  CANCELED
}

enum ActionType {
  BOOK_APPOINTMENT
  SEND_PAYMENT_LINK
  SEND_VIDEO
  HUMAN_HANDOFF
  SEND_EMAIL
  NONE
}

enum MessageStatus {
  received
  processing
  completed
  failed
}

enum ConversationStatus {
  start
  collecting
  pacing
  closing
  failure
  ended
  scheduling
  schedulingConfirmed
  schedulingFailed
}

enum MessageType {
  user
  bot
  system
}

enum BusinessUserRole {
  owner
  admin
  member
}

enum PlatformRole {
  admin
  user
  owner
}
