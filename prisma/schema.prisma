generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id             Int           @id @default(autoincrement())
  externalId     String        @unique
  messageIndex   Int           @default(0)
  content        String
  createdAt      DateTime      @default(now())
  conversationId Int
  status         MessageStatus
  type           MessageType

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, messageIndex])
}

model Conversation {
  id                 Int                    @id @default(autoincrement())
  conclusion         String?
  conversationStatus ConversationStatus
  businessId         Int
  clientId           Int
  channel            String                 @default("whatsapp")
  provider           String                 @default("twilio")
  createdAt          DateTime               @default(now())
  lastUserMessageAt  DateTime?
  lastBotMessageAt   DateTime?
  lastFollowUpAt     DateTime?
  followUpCount      Int                    @default(0)
  nextFollowUpAt     DateTime?
  // Sticky once true: set on any human takeover or human-initiated
  // conversation, never cleared automatically, so the bot pipeline stays
  // silenced even after the conversation is later closed/ended.
  humanManaged       Boolean                @default(false)
  takenOverByUserId  Int?
  takenOverAt        DateTime?
  releasedAt         DateTime?
  business           Business               @relation(fields: [businessId], references: [id])
  client             Client                 @relation(fields: [clientId], references: [id])
  takenOverBy        AppUser?               @relation(fields: [takenOverByUserId], references: [id])
  messages           Message[]
  parameterAnswers   ParameterAnswer[]
  followUps          ConversationFollowUp[]
  createdLeads       Lead[]

  @@index([businessId, humanManaged])
}

model Business {
  id                     Int                     @id @default(autoincrement())
  businessName           String
  businessPhone          String
  businessEmail          String
  enderMessage           String?
  escalationMessage      String?
  language               String
  starterMessage         String?
  parameters             BusinessParameter[]
  users                  BusinessUser[]
  conversations          Conversation[]
  followUpPolicy         BusinessFollowUpPolicy?
  conversationFollowUps  ConversationFollowUp[]
  context                BusinessContext?
  BusinessAction         BusinessAction?
  leads                  Lead[]
  channels               BusinessChannel[]
  integrationConnections IntegrationConnection[]
  incomingLeads          IncomingLead[]
  providerWebhookEvents  ProviderWebhookEvent[]
  externalLeads          ExternalLead[]
  ingestionOutbox        IngestionOutbox[]
  tasks                  Task[]
  taskParticipants       TaskParticipant[]
  taskComments           TaskComment[]
  taskSchedules          TaskSchedule[]
  taskOccurrences        TaskOccurrence[]
  businessActivityEvents BusinessActivityEvent[]
  cases                  Case[]
  schemas                Schema[]
  documentTypes          DocumentType[]
  documentBundles        DocumentBundle[]
}

model MetaLeadFormSubscription {
  id                      Int                            @id @default(autoincrement())
  integrationConnectionId Int
  pageId                  String
  pageName                String?
  formId                  String
  formName                String?
  status                  MetaLeadFormSubscriptionStatus @default(ACTIVE)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  integrationConnection   IntegrationConnection          @relation(fields: [integrationConnectionId], references: [id])

  @@unique([integrationConnectionId, formId])
  @@index([pageId, formId, status])
}

model BusinessContext {
  id                 Int      @id @default(autoincrement())
  businessId         Int      @unique
  profileName        String
  profileLanguage    String
  profileTone        String
  description        String?
  serviceCatalog     Json
  conversationPolicy Json
  knownClientContext Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id])
}

model AppUser {
  id                       Int                     @id @default(autoincrement())
  email                    String                  @unique
  passwordHash             String
  displayName              String?
  platformRole             PlatformRole            @default(user)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  businesses               BusinessUser[]
  leads                    Lead[]
  refreshSessions          RefreshSession[]
  taskParticipants         TaskParticipant[]
  createdTasks             Task[]                  @relation("TaskCreatedBy")
  updatedTasks             Task[]                  @relation("TaskUpdatedBy")
  completedTasks           Task[]                  @relation("TaskCompletedBy")
  cancelledTasks           Task[]                  @relation("TaskCancelledBy")
  deletedTasks             Task[]                  @relation("TaskDeletedBy")
  authoredTaskComments     TaskComment[]           @relation("TaskCommentAuthor")
  deletedTaskComments      TaskComment[]           @relation("TaskCommentDeletedBy")
  createdTaskSchedules     TaskSchedule[]          @relation("TaskScheduleCreatedBy")
  updatedTaskSchedules     TaskSchedule[]          @relation("TaskScheduleUpdatedBy")
  deactivatedTaskSchedules TaskSchedule[]          @relation("TaskScheduleDeactivatedBy")
  assignedTaskOccurrences  TaskOccurrence[]        @relation("TaskOccurrenceAssignee")
  completedTaskOccurrences TaskOccurrence[]        @relation("TaskOccurrenceCompletedBy")
  cancelledTaskOccurrences TaskOccurrence[]        @relation("TaskOccurrenceCancelledBy")
  businessActivityEvents   BusinessActivityEvent[] @relation("BusinessActivityActor")
  pushDevice               PushDevice[]
  takenOverConversations   Conversation[]
  assignedCases            Case[]                  @relation("CaseAssignee")
  authoredCaseComments     CaseComment[]           @relation("CaseCommentAuthor")
  uploadedDocuments        Document[]              @relation("DocumentUploader")
}

model PushDevice {
  id            Int           @id @default(autoincrement())
  appUserId     Int
  deviceId      String
  expoPushToken String        @unique
  platform      PhonePlatform
  appVersion    String
  lastSeenAt    DateTime
  isActive      Boolean

  user AppUser @relation(fields: [appUserId], references: [id])

  @@unique([appUserId, deviceId])
}

model RefreshSession {
  id             Int       @id @default(autoincrement())
  userId         Int
  tokenHash      String    @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  createdAt      DateTime  @default(now())
  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model BusinessUser {
  id         Int              @id @default(autoincrement())
  userId     Int
  businessId Int
  role       BusinessUserRole @default(owner)
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id])
  user       AppUser          @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@unique([businessId, userId])
  @@index([businessId])
}

model Client {
  id            Int               @id @default(autoincrement())
  phoneNumber   String            @unique
  name          String?
  conversations Conversation[]
  answers       ParameterAnswer[]
  leads         Lead[]
}

model BusinessParameter {
  id         Int                   @id @default(autoincrement())
  paramName  String
  businessId Int
  business   Business              @relation(fields: [businessId], references: [id])
  use        Boolean               @default(true)
  // ML-ready value space. TEXT is reserved for legacy rows and the system
  // "Name" parameter; owner-defined parameters must be one of the typed kinds.
  paramType  BusinessParameterType @default(TEXT)
  // CATEGORICAL: { "options": string[] }
  // CONTINUOUS:  { "min"?: number, "max"?: number, "unit"?: string }
  // TIME:        {} (values are ISO 8601 timestamps)
  config     Json?
  answers    ParameterAnswer[]

  @@unique([businessId, paramName])
}

model ParameterAnswer {
  id                Int               @id @default(autoincrement())
  paramAnswer       String
  // Normalized, learnable projections of paramAnswer - exactly one is set,
  // matching the parameter's paramType.
  valueCategory     String?
  valueNumber       Float?
  valueTime         DateTime?
  createdAt         DateTime          @default(now())
  clientId          Int
  paramId           Int
  conversationId    Int
  client            Client            @relation(fields: [clientId], references: [id])
  conversation      Conversation      @relation(fields: [conversationId], references: [id])
  businessParameter BusinessParameter @relation(fields: [paramId], references: [id])

  @@index([conversationId, paramId])
}

model BusinessAction {
  id         Int        @id @default(autoincrement())
  provider   String?
  config     Json?
  action     ActionType
  businessId Int
  business   Business   @relation(fields: [businessId], references: [id])

  @@unique([businessId])
}

model BusinessChannel {
  id                    Int      @id @default(autoincrement())
  businessId            Int
  channel               String
  provider              String
  displayName           String?
  status                String   @default("pending")
  onboardingType        String   @default("manual")
  credentialsEncrypted  String?
  config                Json?
  externalAccountId     String?
  externalPhoneNumberId String?
  webhookUrl            String?
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, channel, provider])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessFollowUpPolicy {
  id               Int      @id @default(autoincrement())
  businessId       Int      @unique
  enabled          Boolean  @default(false)
  timezone         String   @default("UTC")
  delayMinutes     Int      @default(1440)
  allowedStartHour Int?
  allowedEndHour   Int?
  maxFollowUps     Int      @default(1)
  messageTemplate  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id])
}

model ConversationFollowUp {
  id             Int            @id @default(autoincrement())
  businessId     Int
  conversationId Int
  leadId         Int?
  status         FollowUpStatus @default(PENDING)
  scheduledFor   DateTime
  sentAt         DateTime?
  skippedReason  String?
  messageBody    String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id])
  conversation   Conversation   @relation(fields: [conversationId], references: [id])
  lead           Lead?          @relation(fields: [leadId], references: [id])

  @@index([businessId, status, scheduledFor])
  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model Lead {
  id Int @id @default(autoincrement())

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  memberId Int?
  member   AppUser? @relation(fields: [memberId], references: [id])

  status LeadStatus @default(NEW)

  source LeadSource @default(WHATSAPP)
  origin LeadOrigin @default(MANUAL)

  score   Int?
  summary String?
  notes   String?

  name        String?
  email       String?
  phoneNumber String?

  createdAt     DateTime               @default(now())
  asignTime     DateTime?
  updatedAt     DateTime               @updatedAt
  followUpAt    DateTime?
  closedAt      DateTime?
  followUps     ConversationFollowUp[]
  externalLeads ExternalLead[]
  attributions  LeadAttribution[]
  tasks         Task[]
  cases         Case[]

  @@unique([id, businessId])
  @@index([conversationId])
}

model Case {
  id          Int        @id @default(autoincrement())
  businessId  Int
  leadId      Int
  assigneeId  Int?
  name        String
  status      CaseStatus @default(IN_PROGRESS)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  archivedAt  DateTime?

  business               Business                    @relation(fields: [businessId], references: [id])
  lead                   Lead                        @relation(fields: [leadId], references: [id])
  assignee               AppUser?                    @relation("CaseAssignee", fields: [assigneeId], references: [id])
  documents              Document[]
  documentSpecifications CaseDocumentSpecification[]
  comments               CaseComment[]

  // The service layer must ensure the lead and assignee belong to businessId.
  @@index([businessId, status, updatedAt])
  @@index([leadId])
  @@index([assigneeId])
}

model CaseComment {
  id           Int      @id @default(autoincrement())
  caseId       Int
  authorUserId Int
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case   Case    @relation(fields: [caseId], references: [id])
  author AppUser @relation("CaseCommentAuthor", fields: [authorUserId], references: [id])

  @@index([caseId, createdAt, id])
  @@index([authorUserId])
}

model DocumentType {
  id         Int      @id @default(autoincrement())
  businessId Int?
  name       String
  category   String?
  isCustom   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business?  @relation(fields: [businessId], references: [id])
  schemas   Schema[]
  documents Document[]
}

model Schema {
  id                Int      @id @default(autoincrement())
  businessId        Int?
  documentTypeId    Int
  name              String
  version           Int
  requirementSchema Json
  isCustom          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business                   Business?                   @relation(fields: [businessId], references: [id])
  documentType               DocumentType                @relation(fields: [documentTypeId], references: [id])
  documents                  Document[]
  caseDocumentSpecifications CaseDocumentSpecification[]
  documentBundleItems        DocumentBundleItem[]

  @@unique([businessId, documentTypeId, name, version])
  @@index([documentTypeId])
}

model DocumentBundle {
  id          Int      @id @default(autoincrement())
  businessId  Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business             @relation(fields: [businessId], references: [id])
  items    DocumentBundleItem[]

  @@index([businessId, name, id])
}

model DocumentBundleItem {
  id       Int     @id @default(autoincrement())
  bundleId Int
  schemaId Int
  required Boolean @default(true)
  quantity Int     @default(1)
  label    String?
  position Int

  bundle DocumentBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  schema Schema         @relation(fields: [schemaId], references: [id])

  @@unique([bundleId, schemaId])
  @@index([bundleId, position, id])
  @@index([schemaId])
}

model CaseDocumentSpecification {
  id        Int      @id @default(autoincrement())
  caseId    Int
  schemaId  Int
  required  Boolean  @default(true)
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case      Case       @relation(fields: [caseId], references: [id])
  schema    Schema     @relation(fields: [schemaId], references: [id])
  documents Document[]

  @@index([caseId])
  @@index([schemaId])
}

model Document {
  id                          Int            @id @default(autoincrement())
  caseId                      Int
  documentTypeId              Int?
  schemaId                    Int?
  caseDocumentSpecificationId Int?
  filename                    String
  storageKey                  String         @unique
  mimeType                    String
  sizeBytes                   Int
  requirementAnswer           Json?
  status                      DocumentStatus @default(UPLOADED)
  source                      DocumentSource @default(ADVISOR_UPLOAD)
  uploadedById                Int?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  case                      Case                       @relation(fields: [caseId], references: [id])
  documentType              DocumentType?              @relation(fields: [documentTypeId], references: [id])
  schema                    Schema?                    @relation(fields: [schemaId], references: [id])
  caseDocumentSpecification CaseDocumentSpecification? @relation(fields: [caseDocumentSpecificationId], references: [id])
  uploadedBy                AppUser?                   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  // When both are set, schema.documentTypeId must equal documentTypeId. The
  // service/API layer must also ensure the schema and uploader belong to the
  // case's business.
  @@index([caseId, createdAt])
  @@index([documentTypeId])
  @@index([schemaId])
  @@index([caseDocumentSpecificationId])
  @@index([uploadedById])
}

model Task {
  id                 Int               @id @default(autoincrement())
  businessId         Int
  leadId             Int?
  headline           String
  description        String
  status             TaskStatus        @default(OPEN)
  priority           TaskPriority      @default(NORMAL)
  category           String?
  startsAt           DateTime?
  dueAt              DateTime?
  isAllDay           Boolean           @default(false)
  timezone           String            @default("UTC")
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Nullable so system-originated tasks (AI-scheduled callbacks) can exist
  // without a human actor; the owner assigns a person afterwards.
  createdByUserId    Int?
  updatedByUserId    Int?
  completedAt        DateTime?
  completedByUserId  Int?
  cancelledAt        DateTime?
  cancelledByUserId  Int?
  cancellationReason String?
  deletedAt          DateTime?
  deletedByUserId    Int?
  business           Business          @relation(fields: [businessId], references: [id])
  lead               Lead?             @relation(fields: [leadId], references: [id])
  createdBy          AppUser?          @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy          AppUser?          @relation("TaskUpdatedBy", fields: [updatedByUserId], references: [id])
  completedBy        AppUser?          @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])
  cancelledBy        AppUser?          @relation("TaskCancelledBy", fields: [cancelledByUserId], references: [id])
  deletedBy          AppUser?          @relation("TaskDeletedBy", fields: [deletedByUserId], references: [id])
  participants       TaskParticipant[]
  comments           TaskComment[]
  schedules          TaskSchedule[]
  occurrences        TaskOccurrence[]

  @@unique([id, businessId])
  @@index([businessId, status, dueAt])
  @@index([businessId, leadId])
  @@index([businessId, deletedAt, updatedAt])
}

model TaskParticipant {
  id              Int                 @id @default(autoincrement())
  businessId      Int
  taskId          Int
  userId          Int
  role            TaskParticipantRole
  addedAt         DateTime            @default(now())
  addedByUserId   Int
  removedAt       DateTime?
  removedByUserId Int?
  task            Task                @relation(fields: [taskId], references: [id])
  business        Business            @relation(fields: [businessId], references: [id])
  user            AppUser             @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([taskId])
}

model TaskComment {
  id              Int       @id @default(autoincrement())
  businessId      Int
  taskId          Int
  body            String
  authorUserId    Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedByUserId Int?
  task            Task      @relation(fields: [taskId], references: [id])
  business        Business  @relation(fields: [businessId], references: [id])
  author          AppUser   @relation("TaskCommentAuthor", fields: [authorUserId], references: [id])
  deletedBy       AppUser?  @relation("TaskCommentDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([businessId])
  @@index([taskId, createdAt])
}

model TaskSchedule {
  id                         Int              @id @default(autoincrement())
  businessId                 Int
  taskId                     Int
  rrule                      String
  timezone                   String
  isActive                   Boolean          @default(true)
  startsAt                   DateTime?
  endsAt                     DateTime?
  nextOccurrenceAt           DateTime?
  nextNotificationAt         DateTime?
  occurrenceDueOffsetMinutes Int?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  createdByUserId            Int
  updatedByUserId            Int
  deactivatedAt              DateTime?
  deactivatedByUserId        Int?
  task                       Task             @relation(fields: [taskId], references: [id])
  business                   Business         @relation(fields: [businessId], references: [id])
  createdBy                  AppUser          @relation("TaskScheduleCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy                  AppUser          @relation("TaskScheduleUpdatedBy", fields: [updatedByUserId], references: [id])
  deactivatedBy              AppUser?         @relation("TaskScheduleDeactivatedBy", fields: [deactivatedByUserId], references: [id])
  occurrences                TaskOccurrence[]

  @@index([businessId, isActive, nextOccurrenceAt])
  @@index([businessId, isActive, nextNotificationAt])
  @@index([taskId])
}

model TaskOccurrence {
  id                 Int                  @id @default(autoincrement())
  businessId         Int
  taskId             Int
  scheduleId         Int
  scheduledFor       DateTime
  dueAt              DateTime?
  status             TaskOccurrenceStatus @default(SCHEDULED)
  assigneeUserId     Int
  completedAt        DateTime?
  completedByUserId  Int?
  cancelledAt        DateTime?
  cancelledByUserId  Int?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  task               Task                 @relation(fields: [taskId], references: [id])
  schedule           TaskSchedule         @relation(fields: [scheduleId], references: [id])
  business           Business             @relation(fields: [businessId], references: [id])
  assignee           AppUser              @relation("TaskOccurrenceAssignee", fields: [assigneeUserId], references: [id])
  completedBy        AppUser?             @relation("TaskOccurrenceCompletedBy", fields: [completedByUserId], references: [id])
  cancelledBy        AppUser?             @relation("TaskOccurrenceCancelledBy", fields: [cancelledByUserId], references: [id])

  @@unique([scheduleId, scheduledFor])
  @@index([businessId, status, dueAt])
  @@index([taskId])
}

model BusinessActivityEvent {
  id                 Int                           @id @default(autoincrement())
  businessId         Int
  aggregateType      BusinessActivityAggregateType
  aggregateId        Int
  eventType          BusinessActivityEventType
  actorUserId        Int?
  metadata           Json?
  state              BusinessActivityEventState    @default(PENDING)
  dueAt              DateTime                      @default(now())
  lockedUntil        DateTime?
  processingWorkerId String?
  attempts           Int                           @default(0)
  processedAt        DateTime?
  lastError          String?
  dedupeKey          String
  createdAt          DateTime                      @default(now())
  business           Business                      @relation(fields: [businessId], references: [id])
  actor              AppUser?                      @relation("BusinessActivityActor", fields: [actorUserId], references: [id])

  @@unique([businessId, dedupeKey])
  @@index([state, dueAt])
  @@index([lockedUntil])
  @@index([businessId, aggregateType, aggregateId, createdAt])
}

model IntegrationConnection {
  id                        Int                         @id @default(autoincrement())
  businessId                Int
  provider                  String
  integrationType           IntegrationType
  status                    IntegrationConnectionStatus @default(PENDING)
  connectionToken           String                      @unique
  displayName               String?
  externalAccountId         String?
  externalResourceId        String?
  credentialsEncrypted      String?
  webhookSecretEncrypted    String?
  config                    Json?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  business                  Business                    @relation(fields: [businessId], references: [id])
  incomingLeads             IncomingLead[]
  externalLeads             ExternalLead[]
  providerWebhookEvents     ProviderWebhookEvent[]
  metaLeadFormSubscriptions MetaLeadFormSubscription[]
  instagramAccount          InstagramAccount?

  @@unique([businessId, provider, integrationType, externalResourceId])
  @@index([businessId, status])
}

model IncomingLead {
  id                      Int                   @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  provider                String
  eventType               String
  providerEventId         String?
  idempotencyKey          String
  payloadHash             String
  rawPayload              Json?
  canonicalPayload        Json
  status                  IncomingLeadStatus    @default(RECEIVED)
  failureCode             String?
  failureDetail           String?
  receivedAt              DateTime              @default(now())
  processedAt             DateTime?
  externalLeadId          Int?
  business                Business              @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])
  externalLead            ExternalLead?         @relation(fields: [externalLeadId], references: [id])

  @@unique([integrationConnectionId, idempotencyKey])
  @@index([businessId, status, receivedAt])
  @@index([externalLeadId])
}

model ExternalLead {
  id                      Int                   @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  leadId                  Int
  provider                String
  externalLeadId          String
  externalContactId       String?
  metadata                Json?
  firstReceivedAt         DateTime              @default(now())
  lastReceivedAt          DateTime              @default(now())
  business                Business              @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])
  lead                    Lead                  @relation(fields: [leadId], references: [id])
  incomingLeads           IncomingLead[]

  @@unique([integrationConnectionId, externalLeadId])
  @@index([businessId, leadId])
}

model LeadAttribution {
  id                 Int      @id @default(autoincrement())
  leadId             Int
  provider           String?
  campaignExternalId String?
  campaignName       String?
  formExternalId     String?
  formName           String?
  adExternalId       String?
  adSetExternalId    String?
  landingPageUrl     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  referrer           String?
  raw                Json?
  createdAt          DateTime @default(now())
  lead               Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
}

model IngestionOutbox {
  id            Int                   @id @default(autoincrement())
  businessId    Int
  aggregateType String
  aggregateId   Int
  eventType     String
  payload       Json
  status        IngestionOutboxStatus @default(PENDING)
  attempts      Int                   @default(0)
  availableAt   DateTime              @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  business      Business              @relation(fields: [businessId], references: [id])

  @@unique([aggregateType, aggregateId, eventType])
  @@index([status, availableAt])
}

model ProviderWebhookEvent {
  id                      Int                        @id @default(autoincrement())
  businessId              Int
  integrationConnectionId Int
  provider                String
  eventType               String
  providerEventId         String
  payloadHash             String
  payload                 Json
  status                  ProviderWebhookEventStatus @default(RECEIVED)
  attempts                Int                        @default(0)
  nextAttemptAt           DateTime                   @default(now())
  lockedUntil             DateTime?
  workerId                String?
  lastError               String?
  failureCode             String?
  failureDetail           String?
  receivedAt              DateTime                   @default(now())
  processedAt             DateTime?
  business                Business                   @relation(fields: [businessId], references: [id])
  integrationConnection   IntegrationConnection      @relation(fields: [integrationConnectionId], references: [id])

  @@unique([integrationConnectionId, providerEventId])
  @@index([businessId, status, receivedAt])
  @@index([status, nextAttemptAt])
}

